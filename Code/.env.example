# Pinecone stores the embedded report chunks.
PINECONE_API_KEY=

# The local Ollama model used to create embeddings. Do not add an OpenAI key.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# The local Ollama model used for tool calling and financial extraction.
OLLAMA_CHAT_MODEL=qwen3:8b
# Use CPU extraction when qwen3 does not fit in the GPU memory.
OLLAMA_NUM_GPU=0
